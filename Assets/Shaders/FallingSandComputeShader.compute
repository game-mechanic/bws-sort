#pragma kernel SandFall
#pragma kernel Initialize

#define MAX_COLLIDERS 50

RWTexture2D<float4> sandRT;


// ========================================================
// SPAWN
// ========================================================

float posX;
float posY;

float spawnWidth;
float spawnHeight;

bool rightFirst;
bool spawnSand;

float4 color;


// ========================================================
// COLLIDERS
// ========================================================

int colliderCount;
float4 colliderBounds[MAX_COLLIDERS];


// ========================================================
// COLLIDER CHECK
// ========================================================

bool IsCollider(int2 pos)
{
    for (int i = 0; i < colliderCount; i++)
    {
        float4 bounds = colliderBounds[i];

        if (
            pos.x >= bounds.x &&
            pos.x <= bounds.z &&
            pos.y >= bounds.y &&
            pos.y <= bounds.w
        )
        {
            return true;
        }
    }

    return false;
}


// ========================================================
// EMPTY CELL
// ========================================================

bool IsEmpty(
    int2 pos,
    uint width,
    uint height
)
{
    // Screen boundary
    if (
        pos.x < 0 ||
        pos.x >= (int)width ||
        pos.y < 0 ||
        pos.y >= (int)height
    )
    {
        return false;
    }

    // Collider
    if (IsCollider(pos))
    {
        return false;
    }

    float4 pixel = sandRT[pos];

    return pixel.a <= 0.01;
}


// ========================================================
// INITIALIZE
// ========================================================

[numthreads(8, 8, 1)]
void Initialize(uint3 id : SV_DispatchThreadID)
{
    uint width;
    uint height;

    sandRT.GetDimensions(width, height);

    if (
        id.x >= width ||
        id.y >= height
    )
    {
        return;
    }

    sandRT[id.xy] =
        float4(0, 0, 0, 0);
}


// ========================================================
// SAND FALL
// ========================================================

[numthreads(8, 8, 1)]
void SandFall(uint3 id : SV_DispatchThreadID)
{
    uint width;
    uint height;

    sandRT.GetDimensions(width, height);

    if (
        id.x >= width ||
        id.y >= height
    )
    {
        return;
    }

    int2 currentPos =
        int2(id.xy);


    // ====================================================
    // SPAWN
    // ====================================================

    if (spawnSand)
    {
        float left =
            posX - spawnWidth * 0.5;

        float right =
            posX + spawnWidth * 0.5;

        float bottom =
            posY - spawnHeight * 0.5;

        float top =
            posY + spawnHeight * 0.5;

        bool insideSpawn =
            currentPos.x >= left &&
            currentPos.x <= right &&
            currentPos.y >= bottom &&
            currentPos.y <= top;

        if (
            insideSpawn &&
            !IsCollider(currentPos)
        )
        {
            sandRT[currentPos] = color;
        }
    }


    // ====================================================
    // CURRENT SAND
    // ====================================================

    float4 currentSand =
        sandRT[currentPos];

    if (currentSand.a <= 0.01)
    {
        return;
    }


    // ====================================================
    // STRAIGHT DOWN
    // ====================================================

    int2 down =
        currentPos + int2(0, -1);

    if (IsEmpty(
        down,
        width,
        height
    ))
    {
        sandRT[currentPos] =
            float4(0, 0, 0, 0);

        sandRT[down] =
            currentSand;

        return;
    }


    // ====================================================
    // COLLISION
    //
    // Down is blocked.
    // Now try diagonal movement.
    // ====================================================

    int2 downLeft =
        currentPos + int2(-1, -1);

    int2 downRight =
        currentPos + int2(1, -1);


    // ====================================================
    // RANDOMIZED LEFT / RIGHT
    // ====================================================

    if (rightFirst)
    {
        // Right
        if (IsEmpty(
            downRight,
            width,
            height
        ))
        {
            sandRT[currentPos] =
                float4(0, 0, 0, 0);

            sandRT[downRight] =
                currentSand;

            return;
        }

        // Left
        if (IsEmpty(
            downLeft,
            width,
            height
        ))
        {
            sandRT[currentPos] =
                float4(0, 0, 0, 0);

            sandRT[downLeft] =
                currentSand;

            return;
        }
    }
    else
    {
        // Left
        if (IsEmpty(
            downLeft,
            width,
            height
        ))
        {
            sandRT[currentPos] =
                float4(0, 0, 0, 0);

            sandRT[downLeft] =
                currentSand;

            return;
        }

        // Right
        if (IsEmpty(
            downRight,
            width,
            height
        ))
        {
            sandRT[currentPos] =
                float4(0, 0, 0, 0);

            sandRT[downRight] =
                currentSand;

            return;
        }
    }


    // ====================================================
    // SAND IS COMPLETELY BLOCKED
    // ====================================================

    // Do nothing.
    // Grain stays in place.
}